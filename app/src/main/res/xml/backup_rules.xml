<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 及以下的云备份规则（API 31+ 由 data_extraction_rules.xml 接管）。
     DataStore 文件位于 files/datastore/ 下：
     - auth_prefs.preferences_pb 含 JWT 登录凭证，禁止随备份迁移到云端/新设备
     - settings_prefs（主题等无害偏好）允许备份 -->
<full-backup-content>
    <exclude domain="file" path="datastore/auth_prefs.preferences_pb" />
</full-backup-content>
