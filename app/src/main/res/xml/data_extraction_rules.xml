<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ 的云备份与设备迁移规则。
     排除 auth_prefs（JWT 登录凭证），避免 Token 经云备份/换机迁移泄漏。 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/auth_prefs.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/auth_prefs.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
